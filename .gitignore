# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/

# Local scratch data (raw API responses kept for debugging)
data/raw/

# Never commit private keys (SerpApi lives in the shell or CI secrets)
.env
*.key

# Raw API pages cached by build_osu_class_estimates.py so a failed run resumes
# instead of re-fetching ~500 requests. Large (GBs) and rebuildable.
data/osu/.cache/
